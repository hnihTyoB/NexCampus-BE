<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Weekly Evaluation Report – Week {{week}}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    :root {
      --brand:       #1e40af;
      --brand-light: #dbeafe;
      --brand-mid:   #3b82f6;
      --accent:      #0ea5e9;
      --ai-bg:       #f0fdf4;
      --ai-border:   #16a34a;
      --ai-text:     #15803d;
      --surface:     #f8fafc;
      --border:      #e2e8f0;
      --text-main:   #0f172a;
      --text-muted:  #64748b;
      --up-color:    #16a34a;
      --down-color:  #dc2626;
      --neutral:     #64748b;
      --done-color:  #15803d;
      --todo-color:  #64748b;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', sans-serif;
      color: var(--text-main);
      background: #ffffff;
      font-size: 10.5pt;
      line-height: 1.55;
    }

    /* ─── HEADER ───────────────────────────────── */
    .report-header {
      background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 50%, #2563eb 100%);
      color: #fff;
      padding: 22px 28px 18px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    .header-left .org-name {
      font-size: 8pt;
      font-weight: 500;
      letter-spacing: 2px;
      text-transform: uppercase;
      opacity: 0.75;
      margin-bottom: 6px;
    }
    .header-left .report-title {
      font-size: 18pt;
      font-weight: 800;
      letter-spacing: -0.5px;
      line-height: 1.2;
    }
    .header-left .week-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 8px;
      background: rgba(255,255,255,0.2);
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 9pt;
      font-weight: 600;
    }
    .header-left .week-range {
      font-size: 8pt;
      opacity: 0.8;
      margin-top: 4px;
    }
    .header-right {
      text-align: right;
    }
    .header-right .report-logo {
      height: 52px;
      max-width: 140px;
      object-fit: contain;
      margin-left: auto;
      display: block;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
    }
    .header-right .logo-box {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: rgba(255,255,255,0.18);
      border: 1.5px solid rgba(255,255,255,0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22pt;
      font-weight: 900;
      color: #fff;
      margin-left: auto;
    }
    .header-right .doc-id {
      font-size: 7pt;
      opacity: 0.6;
      margin-top: 8px;
      font-family: monospace;
    }

    /* ─── LAYOUT ────────────────────────────────── */
    .page-body { padding: 20px 28px; }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 14px;
    }
    .three-col {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 12px;
      margin-bottom: 14px;
    }

    /* ─── SECTION HEADER ────────────────────────── */
    .section {
      margin-bottom: 14px;
    }
    .section-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 8pt;
      font-weight: 700;
      color: var(--brand);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      padding-bottom: 6px;
      border-bottom: 2px solid var(--brand-light);
      margin-bottom: 10px;
    }
    .section-title .icon {
      width: 20px;
      height: 20px;
      border-radius: 5px;
      background: var(--brand);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 7.5pt;
      font-weight: 700;
      letter-spacing: 0;
    }

    /* ─── INFO CARD ─────────────────────────────── */
    .info-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
    }
    .info-row {
      display: flex;
      padding: 4px 0;
      border-bottom: 1px solid var(--border);
      font-size: 9.5pt;
    }
    .info-row:last-child { border-bottom: none; }
    .info-label {
      color: var(--text-muted);
      font-weight: 500;
      width: 140px;
      flex-shrink: 0;
      font-size: 9pt;
    }
    .info-value { font-weight: 600; color: var(--text-main); }

    /* ─── STAT CARDS ────────────────────────────── */
    .stat-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 14px;
      text-align: center;
    }
    .stat-card .stat-value {
      font-size: 20pt;
      font-weight: 800;
      color: var(--brand);
      line-height: 1.1;
    }
    .stat-card .stat-label {
      font-size: 8pt;
      color: var(--text-muted);
      font-weight: 500;
      margin-top: 2px;
    }
    .stat-card.highlight { background: var(--brand); border-color: var(--brand); }
    .stat-card.highlight .stat-value,
    .stat-card.highlight .stat-label { color: #fff; }

    /* ─── PROGRESS BAR ──────────────────────────── */
    .score-bars { display: flex; flex-direction: column; gap: 8px; }
    .bar-row { display: flex; align-items: center; gap: 10px; font-size: 9pt; }
    .bar-label { width: 110px; flex-shrink: 0; color: var(--text-main); font-weight: 500; }
    .bar-track {
      flex: 1;
      height: 10px;
      background: #e2e8f0;
      border-radius: 99px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      border-radius: 99px;
      background: linear-gradient(90deg, var(--brand-mid), var(--accent));
      transition: width 0.3s;
    }
    .bar-score {
      width: 32px;
      text-align: right;
      font-weight: 700;
      color: var(--brand);
      font-size: 9.5pt;
    }

    /* ─── COMPARISON TABLE ──────────────────────── */
    table.compare-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9.5pt;
    }
    .compare-table th {
      background: var(--brand);
      color: #fff;
      font-weight: 600;
      padding: 7px 10px;
      text-align: center;
      font-size: 8.5pt;
      letter-spacing: 0.3px;
    }
    .compare-table th:first-child { text-align: left; border-radius: 8px 0 0 0; }
    .compare-table th:last-child  { border-radius: 0 8px 0 0; }
    .compare-table td {
      padding: 7px 10px;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }
    .compare-table td:first-child { text-align: left; font-weight: 500; }
    .compare-table tr:last-child td { border-bottom: none; }
    .compare-table tr:nth-child(even) td { background: var(--surface); }
    .delta-pos { color: var(--up-color); font-weight: 700; }
    .delta-neg { color: var(--down-color); font-weight: 700; }
    .delta-neu { color: var(--neutral); font-weight: 500; }
    .total-row td { background: var(--brand-light) !important; font-weight: 700; color: var(--brand); }

    /* ─── OVERALL SCORE ─────────────────────────── */
    .overall-score-box {
      background: linear-gradient(135deg, var(--brand) 0%, var(--accent) 100%);
      border-radius: 12px;
      padding: 18px 20px;
      color: #fff;
      text-align: center;
      margin-bottom: 14px;
    }
    .overall-score-box .score-num {
      font-size: 36pt;
      font-weight: 900;
      letter-spacing: -1px;
      line-height: 1;
    }
    .overall-score-box .score-label {
      font-size: 8pt;
      opacity: 0.8;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-top: 4px;
    }
    .overall-score-box .score-sub {
      font-size: 8.5pt;
      opacity: 0.7;
      margin-top: 6px;
    }

    /* ─── LEADER COMMENT ────────────────────────── */
    .comment-box {
      background: var(--surface);
      border-left: 4px solid var(--brand);
      border-radius: 0 8px 8px 0;
      padding: 12px 14px;
      font-size: 9.5pt;
      color: var(--text-main);
      line-height: 1.65;
      font-style: italic;
    }

    /* ─── AI SECTION ────────────────────────────── */
    .ai-wrapper {
      background: var(--ai-bg);
      border: 1px solid #bbf7d0;
      border-radius: 10px;
      padding: 14px 16px;
    }
    .ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: var(--ai-border);
      color: #fff;
      border-radius: 99px;
      padding: 3px 10px;
      font-size: 7.5pt;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .ai-subsection { margin-bottom: 10px; }
    .ai-subsection-title {
      font-size: 8pt;
      font-weight: 700;
      color: var(--ai-text);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 5px;
    }
    .ai-list { list-style: none; padding: 0; }
    .ai-list li {
      font-size: 9.5pt;
      padding: 3px 0 3px 18px;
      position: relative;
      color: var(--text-main);
      border-bottom: 1px solid #d1fae5;
    }
    .ai-list li:last-child { border-bottom: none; }
    .ai-list.strengths li::before { content: ">"; position: absolute; left: 0; color: var(--ai-text); font-weight: 700; }
    .ai-list.improve  li::before { content: "—"; position: absolute; left: 0; color: #dc2626; font-weight: 700; }
    .ai-recommendation {
      background: #dcfce7;
      border-radius: 6px;
      padding: 8px 12px;
      font-size: 9.5pt;
      color: #166534;
      margin-top: 6px;
    }
    .ai-no-data {
      font-size: 9pt;
      color: var(--text-muted);
      font-style: italic;
    }

    /* ─── PROGRESS TRENDS ───────────────────────── */
    .trend-wrapper {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 10px;
      padding: 14px 16px;
    }
    .trend-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: var(--brand);
      color: #fff;
      border-radius: 99px;
      padding: 3px 10px;
      font-size: 7.5pt;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .trend-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 10px;
    }
    .trend-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #fff;
      border: 1px solid #bfdbfe;
      border-radius: 8px;
      padding: 8px 12px;
    }
    .trend-item .t-label { font-size: 9pt; font-weight: 500; color: var(--text-main); }
    .trend-item .t-scores { font-size: 8.5pt; color: var(--text-muted); }
    .trend-item .t-delta { font-size: 10pt; font-weight: 700; }
    .t-delta.up   { color: var(--up-color); }
    .t-delta.down { color: var(--down-color); }
    .t-delta.same { color: var(--neutral); }
    .trend-summary {
      background: #dbeafe;
      border-radius: 6px;
      padding: 8px 12px;
      font-size: 9.5pt;
      color: #1e40af;
      font-weight: 500;
    }

    /* ─── TASK LIST ─────────────────────────────── */
    table.task-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9pt;
    }
    .task-table th {
      background: #1e40af;
      color: #fff;
      padding: 6px 10px;
      text-align: left;
      font-size: 8.5pt;
      font-weight: 600;
    }
    .task-table th:first-child { border-radius: 8px 0 0 0; }
    .task-table th:last-child  { border-radius: 0 8px 0 0; text-align: center; }
    .task-table td {
      padding: 6px 10px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }
    .task-table td:last-child { text-align: center; }
    .task-table tr:nth-child(even) td { background: var(--surface); }
    .task-table tr:last-child td { border-bottom: none; }
    .status-done { color: var(--done-color); font-weight: 700; }
    .status-todo { color: var(--todo-color); font-weight: 500; }
    .task-code   { font-family: monospace; color: var(--brand); font-size: 8pt; }

    /* ─── SIGNATURE ─────────────────────────────── */
    .signature-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 20px;
    }
    .sig-block {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
      text-align: center;
      background: var(--surface);
    }
    .sig-block .sig-role {
      font-size: 8pt;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 40px;
    }
    .sig-block .sig-line {
      border-top: 1.5px solid var(--text-main);
      margin-bottom: 8px;
    }
    .sig-block .sig-name { font-weight: 700; font-size: 10pt; color: var(--text-main); }
    .sig-block .sig-meta { font-size: 8pt; color: var(--text-muted); margin-top: 2px; }

    /* ─── QR + VERIFY ───────────────────────────── */
    .verify-section {
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 16px;
      margin-top: 14px;
    }
    .verify-section img { width: 72px; height: 72px; border-radius: 6px; }
    .verify-text .v-title {
      font-size: 8.5pt;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 3px;
    }
    .verify-text .v-sub {
      font-size: 8pt;
      color: var(--text-muted);
    }
    .verify-text .v-id {
      font-size: 7.5pt;
      font-family: monospace;
      color: var(--brand);
      background: var(--brand-light);
      padding: 2px 6px;
      border-radius: 4px;
      margin-top: 4px;
      display: inline-block;
    }

    /* ─── MISC ──────────────────────────────────── */
    .divider {
      height: 1px;
      background: var(--border);
      margin: 16px 0;
    }
    .page-break { page-break-before: always; }
  </style>
</head>
<body>

  <!-- ════ HEADER ════ -->
  <div class="report-header">
    <div class="header-left">
      <div class="org-name">NexCampus · Internship Management System</div>
      <div class="report-title">Weekly Evaluation<br>Report</div>
      <div class="week-badge">Week {{week}}</div>
      <div class="week-range">{{weekRange}}</div>
    </div>
    <div class="header-right">
      {{#if logoBase64}}
        <img src="{{logoBase64}}" alt="NexCampus Logo" class="report-logo" />
      {{else}}
        <div class="logo-box">N</div>
      {{/if}}
      <div class="doc-id">REF: {{id}}</div>
    </div>
  </div>

  <div class="page-body">

    <!-- ════ SECTION 1: INTERN + LEADER INFO ════ -->
    <div class="section" style="margin-top:16px;">
      <div class="section-title">
        <div class="icon">01</div>
        Internship Information
      </div>
      <div class="two-col">
        <div class="info-card">
          <div class="info-row">
            <span class="info-label">Intern</span>
            <span class="info-value">{{internName}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">ID</span>
            <span class="info-value" style="font-family:monospace;font-size:9pt;">{{internCode}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Department</span>
            <span class="info-value">{{department}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Position</span>
            <span class="info-value">{{position}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Start Date</span>
            <span class="info-value">{{internStartDate}}</span>
          </div>
        </div>
        <div class="info-card">
          <div class="info-row">
            <span class="info-label">Leader</span>
            <span class="info-value">{{leaderName}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Position</span>
            <span class="info-value">{{leaderPosition}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Evaluation Week</span>
            <span class="info-value">Week {{week}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Period</span>
            <span class="info-value">{{weekRange}}</span>
          </div>
          <div class="info-row">
            <span class="info-label">Generated</span>
            <span class="info-value">{{generatedAt}}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ════ SECTION 2: PERFORMANCE SUMMARY ════ -->
    <div class="section">
      <div class="section-title">
        <div class="icon">02</div>
        Performance Summary
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:10px;">
        <div class="stat-card highlight">
          <div class="stat-value">{{performance.taskCompleted}}/{{performance.taskTotal}}</div>
          <div class="stat-label">Tasks Completed</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{{performance.taskCompletionRate}}%</div>
          <div class="stat-label">Completion Rate</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{{performance.dailyReportTotal}}/7</div>
          <div class="stat-label">Daily Reports</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{{performance.submissionTotal}}</div>
          <div class="stat-label">Submissions</div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
        <div class="stat-card">
          <div class="stat-value" style="color:#dc2626;">{{performance.rejectedTotal}}</div>
          <div class="stat-label">Rejected Submissions</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">{{performance.avgAttemptsPerTask}}</div>
          <div class="stat-label">Avg. Attempts / Task</div>
        </div>
      </div>
    </div>

    <!-- ════ SECTION 3: SCORE OVERVIEW ════ -->
    <div class="section">
      <div class="section-title">
        <div class="icon">03</div>
        Overall Evaluation Score
      </div>
      <div class="two-col">
        <!-- Overall Score Box -->
        <div class="overall-score-box">
          <div class="score-label">Overall Evaluation Score</div>
          <div class="score-num">{{formatScore totalScore}}</div>
          <div class="score-sub">/ 10.0 · Week {{week}} · {{weekRange}}</div>
        </div>
        <!-- Score Bars -->
        <div class="info-card" style="justify-content:center;display:flex;flex-direction:column;">
          <div class="score-bars">
            {{#each scoreBars}}
            <div class="bar-row">
              <span class="bar-label">{{label}}</span>
              <div class="bar-track">
                <div class="bar-fill" style="width:{{percentage}}%;"></div>
              </div>
              <span class="bar-score">{{formatScore score}}</span>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
    </div>

    <!-- ════ SECTION 4: LEADER vs AI COMPARISON ════ -->
    <div class="section">
      <div class="section-title">
        <div class="icon">04</div>
        Leader vs AI Score Comparison
      </div>
      <table class="compare-table">
        <thead>
          <tr>
            <th>Criteria</th>
            <th>AI Score</th>
            <th>Leader Score</th>
            <th>Delta (Leader–AI)</th>
          </tr>
        </thead>
        <tbody>
          {{#each scoreComparison}}
          <tr>
            <td>{{label}}</td>
            <td>{{#if aiScore}}{{formatScore aiScore}}{{else}}–{{/if}}</td>
            <td><strong>{{formatScore leaderScore}}</strong></td>
            <td>
              {{#if delta}}
                <span class="{{#if deltaPositive}}delta-pos{{else}}delta-neg{{/if}}">{{delta}}</span>
              {{else}}
                <span class="delta-neu">–</span>
              {{/if}}
            </td>
          </tr>
          {{/each}}
          <tr class="total-row">
            <td>Overall Evaluation Score</td>
            <td>–</td>
            <td>{{formatScore totalScore}}</td>
            <td>–</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- ════ SECTION 5: LEADER EVALUATION ════ -->
    <div class="section">
      <div class="section-title">
        <div class="icon">05</div>
        Leader Evaluation
      </div>
      <div class="comment-box">
        {{comment}}
      </div>
    </div>

    <!-- ════ SECTION 6: AI ANALYSIS ════ -->
    <div class="section">
      <div class="section-title">
        <div class="icon">06</div>
        AI Analysis
      </div>
      {{#if hasAiEvaluation}}
      <div class="ai-wrapper">
        <div class="ai-badge">AI Generated · {{aiGeneratedAt}}</div>

        {{#if aiStrengths.length}}
        <div class="ai-subsection">
          <div class="ai-subsection-title">Strengths</div>
          <ul class="ai-list strengths">
            {{#each aiStrengths}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
        {{/if}}

        {{#if aiImprovements.length}}
        <div class="ai-subsection">
          <div class="ai-subsection-title">Areas to Improve</div>
          <ul class="ai-list improve">
            {{#each aiImprovements}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
        {{/if}}

        {{#if aiRecommendation}}
        <div class="ai-subsection">
          <div class="ai-subsection-title">Recommendation for Next Week</div>
          <div class="ai-recommendation">{{aiRecommendation}}</div>
        </div>
        {{/if}}
      </div>
      {{else}}
      <div class="ai-wrapper">
        <p class="ai-no-data">Chưa có phân tích AI cho đánh giá tuần này. Leader có thể kích hoạt tính năng đánh giá AI trong NexCampus Dashboard.</p>
      </div>
      {{/if}}
    </div>

    <!-- ════ SECTION 7: AI PROGRESS ANALYSIS ════ -->
    {{#if hasPreviousWeek}}
    <div class="section">
      <div class="section-title">
        <div class="icon">07</div>
        AI Progress Analysis
      </div>
      <div class="trend-wrapper">
        <div class="trend-badge">Week-over-Week Comparison</div>
        <div class="trend-grid">
          {{#each progressTrends}}
          <div class="trend-item">
            <div>
              <div class="t-label">{{label}}</div>
              <div class="t-scores">{{formatScore previous}} → {{formatScore current}}</div>
            </div>
            <div class="t-delta {{#if isUp}}up{{else}}{{#if isDown}}down{{else}}same{{/if}}{{/if}}">
              {{delta}}
            </div>
          </div>
          {{/each}}
        </div>
        <div class="trend-summary">{{progressSummary}}</div>
      </div>
    </div>
    {{/if}}

    <!-- ════ SECTION 8: TASK LIST ════ -->
    {{#if tasks.length}}
    <div class="section">
      <div class="section-title">
        <div class="icon">08</div>
        Tasks This Week
      </div>
      <table class="task-table">
        <thead>
          <tr>
            <th style="width:70px;">Code</th>
            <th>Task Title</th>
            <th style="width:80px;text-align:center;">Status</th>
            <th style="width:80px;text-align:center;">Submissions</th>
          </tr>
        </thead>
        <tbody>
          {{#each tasks}}
          <tr>
            <td><span class="task-code">{{#if code}}{{code}}{{else}}–{{/if}}</span></td>
            <td>{{title}}</td>
            <td>
              {{#if isDone}}
                <span class="status-done">Done</span>
              {{else}}
                <span class="status-todo">{{status}}</span>
              {{/if}}
            </td>
            <td style="text-align:center;">{{submissionCount}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/if}}

    <!-- ════ SIGNATURE ════ -->
    <div class="divider"></div>
    <div class="signature-section">
      <div class="sig-block">
        <div class="sig-role">Intern</div>
        <div class="sig-line"></div>
        <div class="sig-name">{{internName}}</div>
        <div class="sig-meta">{{position}}</div>
        <div class="sig-meta" style="margin-top:4px;">Ngày: ___/___/_______</div>
      </div>
      <div class="sig-block">
        <div class="sig-role">Team Leader</div>
        <div class="sig-line"></div>
        <div class="sig-name">{{leaderName}}</div>
        <div class="sig-meta">{{leaderPosition}}</div>
        <div class="sig-meta" style="margin-top:4px;">Ngày: ___/___/_______</div>
      </div>
    </div>

    <!-- ════ QR VERIFICATION ════ -->
    <div class="verify-section">
      <img src="{{qrCodeUrl}}" alt="QR Code" />
      <div class="verify-text">
        <div class="v-title">Document Verification</div>
        <div class="v-sub">Quét mã QR để xác minh tính xác thực của báo cáo này trên hệ thống NexCampus.</div>
        <div class="v-id">PDF-{{id}}</div>
      </div>
    </div>

  </div><!-- end page-body -->
</body>
</html>
