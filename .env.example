# =============================================================================
# 1. CORE APPLICATION & ENVIRONMENT
# =============================================================================
NODE_ENV=development
PORT=9999
APP_URL=http://localhost:7777

# =============================================================================
# 2. DATABASE (PostgreSQL / Supabase)
# =============================================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/template_db?schema=public"

# =============================================================================
# 3. JWT AUTHENTICATION & TOKENS
# =============================================================================
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# 4. SECURITY, REVERSE PROXY & CORS
# =============================================================================
# TRUST_PROXY: true, false, loopback, linklocal, uniquelocal, specific IP/CIDR, or number of hops
TRUST_PROXY=false
# ALLOWED_ORIGINS: Comma-separated list of allowed CORS domains (Wildcard * disallowed in production)
ALLOWED_ORIGINS=http://localhost:7777,http://localhost:3000,http://localhost:5173

# =============================================================================
# 5. ENCRYPTION & DATA PROTECTION (AES-256-GCM)
# =============================================================================
# Master Encryption Key (Must be at least 32 characters long in production)
ENCRYPTION_KEY=your_32_character_master_secret_key!
APP_SECRET=your_32_character_master_secret_key!

# =============================================================================
# 6. REDIS & DISTRIBUTED PUBSUB / BULLMQ
# =============================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
# Optional Redis connection string / DSN (if provided, overrides REDIS_HOST/PORT/PASSWORD)
REDIS_URL=

# =============================================================================
# 7. RATE LIMITING (In-Memory Sliding Log)
# =============================================================================
# General API Rate Limiting: 1000 requests per 15 minutes (900000 ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
# Auth Sensitive Endpoints (Login, 2FA, Password Reset): 30 requests per 15 minutes
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=30

# =============================================================================
# 8. CLOUDFLARE R2 / S3 OBJECT STORAGE
# =============================================================================
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BASE_URL=https://your-public-r2-url.r2.dev
R2_PRESIGNED_URL_EXPIRES_IN_SECONDS=300
R2_AVATAR_MAX_FILE_SIZE_MB=5

# =============================================================================
# 9. NOTIFICATION BACKGROUND WORKER
# =============================================================================
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=60000

# =============================================================================
# 10. WEBHOOK DELIVERY & RETRIES
# =============================================================================
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=10000

# =============================================================================
# 11. GOOGLE OAUTH2 SOCIAL LOGIN
# =============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =============================================================================
# 12. MAIL / SMTP DELIVERY
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_specific_password
MAIL_FROM="App Template <noreply@gmail.com>"