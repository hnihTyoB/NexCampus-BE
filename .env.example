NODE_ENV=development
PORT=8888
BASE_URL=http://localhost:3000
TRUST_PROXY=false

# Database
DATABASE_URL=postgresql://postgres:[DB_PASSWORD]@localhost:[DB_PORT]/[DB_NAME]?schema=public
DB_HOST=localhost
DB_PORT=[DB_PORT]
DB_USER=postgres
DB_PASSWORD=[PASSWORD]
DB_NAME=[DB_NAME]

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://[project-ref].supabase.co/auth/v1/.well-known/jwks.json

# Storage
SUPABASE_STORAGE_TASK_BUCKET=task-attachments
SUPABASE_STORAGE_SUBMISSION_BUCKET=submission-attachments
SUPABASE_STORAGE_REPORT_BUCKET=report-attachments
SUPABASE_STORAGE_AVATAR_BUCKET=avatars
SUPABASE_STORAGE_MAX_FILE_SIZE_MB=50
STORAGE_CLEANUP_RETENTION_DAYS=30
STORAGE_CLEANUP_CRON=0 2 * * *

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=NexCampus <no-reply@nexcampus.local>

# Discord Webhook
DISCORD_WEBHOOK_URL=

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=key1,key2,key3

# AI Provider
AI_PROVIDER=gemini

# Reminders
REMINDER_CRON=0 8 * * *
REMINDER_TASK_THRESHOLD_HOURS=24