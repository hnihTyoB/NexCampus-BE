generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String?   @unique
  password    String?
  fullName    String?   @map("full_name")
  avatarUrl   String?   @map("avatar_url")
  phoneNumber String?   @unique @map("phone_number")
  isActive    Boolean   @default(false) @map("is_active")
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorBackupCodes Json?     @map("two_factor_backup_codes")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens       RefreshToken[]
  socialAccounts      UserSocial[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  devices             UserDevice[]
  notifications       Notification[]
  emailNotifications  EmailNotification[]
  apiKeys             ApiKey[]
  webhookEndpoints    WebhookEndpoint[]
  webhookDeliveries   WebhookDelivery[]
  intern              Intern?              @relation("InternUser")
  leadedInterns       Intern[]             @relation("LeaderInterns")
  leader              Leader?
  approvedApplications Application[]        @relation("ApprovedApplications")
  rejectedApplications Application[]        @relation("RejectedApplications")
  createdInvites       ApplicationInvite[]
  createdTasks                  Task[]                 @relation("CreatedTasks")
  uploadedAttachments           TaskAttachment[]       @relation("TaskAttachmentUploader")
  assignedTasks                 TaskAssignment[]       @relation("AssignedTasks")
  reviewedSubmissions           TaskSubmission[]       @relation("ReviewedSubmissions")
  reviewedExtensionRequests    TaskExtensionRequest[] @relation("ReviewedExtensionRequests")
  uploadedSubmissionAttachments SubmissionAttachment[] @relation("SubmissionAttachmentUploader")
  createdMeetings               Meeting[]              @relation("CreatedMeetings")
  hostedMeetings                Meeting[]              @relation("HostedMeetings")
  meetingParticipants           MeetingParticipant[]
  reviewedMeetingAbsences       AbsenceRequest[]       @relation("ReviewedAbsences")
  absences                      Absence[]              @relation("InternAbsences")
  reviewedAbsences              Absence[]              @relation("ReviewedGeneralAbsences")
  feedbackDailyReports          DailyReport[]          @relation("FeedbackDailyReports")
  uploadedReportAttachments     ReportAttachment[]     @relation("ReportAttachmentUploader")
  leaderEvaluations             WeeklyEvaluation[]     @relation("LeaderEvaluations")
  notificationSetting           NotificationSetting?
  auditLogs                     AuditLog[]             @relation("UserAuditLogs")
  exports                       ExportHistory[]        @relation("UserExports")

  @@index([deletedAt])
  @@index([roleId, isActive, deletedAt])
  @@index([isActive, deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  resource    String
  action      String
  isSystem    Boolean          @default(false) @map("is_system")
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor      User?    @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSocial {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String // "ZALO", "GOOGLE", etc.
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_socials")
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  type      String   @default("EMAIL_VERIFICATION")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  deviceHash  String   @map("device_hash")
  deviceName  String?  @map("device_name")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  lastLoginAt DateTime @default(now()) @map("last_login_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@map("user_devices")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  priority  String    @default("NORMAL")
  title     String
  content   String
  actionUrl String?   @map("action_url")
  metadata  Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model EmailNotification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  toEmail      String    @map("to_email")
  subject      String
  templateKey  String    @map("template_key")
  templateData Json      @map("template_data")
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, attempts, createdAt])
  @@index([userId])
  @@index([toEmail])
  @@map("email_notifications")
}

model NotificationTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  channels    Json
  subject     String?
  title       String?
  content     String
  variables   Json
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, createdAt])
  @@index([isSystem, createdAt])
  @@map("notification_templates")
}

model NotificationSetting {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  emailEnabled   Boolean  @default(true) @map("email_enabled")
  inAppEnabled   Boolean  @default(true) @map("in_app_enabled")
  webEnabled     Boolean  @default(true) @map("web_enabled")

  taskAssignedEmail        Boolean @default(true) @map("task_assigned_email")
  taskAssignedInApp        Boolean @default(true) @map("task_assigned_in_app")
  submissionReviewedEmail  Boolean @default(true) @map("submission_reviewed_email")
  submissionReviewedInApp  Boolean @default(true) @map("submission_reviewed_in_app")
  dailyReportReminderEmail Boolean @default(true) @map("daily_report_reminder_email")
  dailyReportReminderInApp Boolean @default(true) @map("daily_report_reminder_in_app")
  meetingScheduleEmail     Boolean @default(true) @map("meeting_schedule_email")
  meetingScheduleInApp     Boolean @default(true) @map("meeting_schedule_in_app")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}


model MaintenanceConfig {
  id                String    @id @default(uuid()) @db.Uuid
  key               String    @unique @default("DEFAULT")
  enabled           Boolean   @default(false)
  status            String    @default("ONLINE")
  title             String    @default("Hệ thống đang bảo trì")
  message           String    @default("Hệ thống đang được bảo trì để nâng cấp dịch vụ. Vui lòng quay lại sau.")
  startAt           DateTime? @map("start_at")
  estimatedEndAt    DateTime? @map("estimated_end_at")
  bypassPermissions Json      @default("[\"MAINTENANCE_MANAGE\", \"MAINTENANCE_BYPASS\"]") @map("bypass_permissions")
  bypassRoles       Json      @default("[\"ADMIN\"]") @map("bypass_roles")
  bypassIps         Json      @default("[]") @map("bypass_ips")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("maintenance_configs")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  keyHash     String    @unique @map("key_hash")
  prefix      String
  userId      String    @map("user_id") @db.Uuid
  permissions Json      @default("[]")
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("api_keys")
}

model WebhookEndpoint {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  url             String
  encryptedSecret String   @map("encrypted_secret")
  events          Json     @default("[\"*\"]")
  isActive        Boolean  @default(true) @map("is_active")
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([isActive])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  webhookEndpointId String    @map("webhook_endpoint_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  event             String
  payload           Json
  signature         String
  status            String    @default("PENDING")
  statusCode        Int?      @map("status_code")
  responseBody      String?   @map("response_body")
  attempts          Int       @default(0)
  lastError         String?   @map("last_error")
  deliveredAt       DateTime? @map("delivered_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  category    String   @default("GENERAL") // GENERAL, FEATURE_FLAG, INTEGRATION, SECURITY
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([isPublic])
  @@map("system_configs")
}

enum InternStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model Department {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?   @db.Text
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  positions         Position[]
  interns           Intern[]
  leaderAssignments LeaderDepartment[]
  applications      Application[]
  taskGroups        TaskGroup[]
  meetings          Meeting[]

  @@index([deletedAt])
  @@map("departments")
}

model Position {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  name         String
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  interns      Intern[]
  applications Application[]

  @@index([departmentId])
  @@index([deletedAt])
  @@map("positions")
}

model Leader {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  position  String?
  phone     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  departments LeaderDepartment[]

  @@map("leaders")
}

model LeaderDepartment {
  leaderId     String   @map("leader_id") @db.Uuid
  departmentId String   @unique @map("department_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  leader     Leader     @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([leaderId, departmentId])
  @@index([departmentId])
  @@map("leader_departments")
}

model Intern {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @map("user_id") @db.Uuid
  leaderId           String?      @map("leader_id") @db.Uuid
  fullName           String       @map("full_name")
  phone              String       @unique
  departmentId       String?      @map("department_id") @db.Uuid
  positionId         String?      @map("position_id") @db.Uuid
  startDate          DateTime     @map("start_date")
  duration           Int
  discordUsername    String?      @map("discord_username")
  discordRoleGranted Boolean      @default(false) @map("discord_role_granted")
  status             InternStatus @default(ACTIVE)
  internCode         String?      @unique @map("intern_code")
  university         String?      @map("university")
  major              String?      @map("major")
  deletedAt          DateTime?    @map("deleted_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user                      User                     @relation("InternUser", fields: [userId], references: [id], onDelete: Cascade)
  leader                    User?                    @relation("LeaderInterns", fields: [leaderId], references: [id], onDelete: SetNull)
  department                Department?              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position                  Position?                @relation(fields: [positionId], references: [id], onDelete: Restrict)
  taskGroupMembers          TaskGroupMember[]
  assignedTasks             TaskAssignment[]         @relation("TaskAssignmentOwner")
  supportTasks              TaskAssignment[]         @relation("TaskAssignmentSupport")
  dailyReports              DailyReport[]
  weeklyEvaluations         WeeklyEvaluation[]
  regulationAcknowledgments RegulationAcknowledgment[]
  extensionRequests         TaskExtensionRequest[]

  @@index([leaderId])
  @@index([departmentId])
  @@index([positionId])
  @@index([status])
  @@index([deletedAt])
  @@map("interns")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationInviteStatus {
  UNUSED
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

model Application {
  id                  String            @id @default(uuid()) @db.Uuid
  fullName            String            @map("full_name")
  email               String
  phone               String
  university          String?           @map("university")
  major               String?           @map("major")
  cvUrl               String?           @map("cv_url")
  preferredDepartment String?           @map("preferred_department")
  preferredPosition   String?           @map("preferred_position")
  departmentId        String?           @map("department_id") @db.Uuid
  positionId          String?           @map("position_id") @db.Uuid
  startDate           DateTime          @map("start_date")
  duration            Int               @default(3)
  status              ApplicationStatus @default(PENDING)
  approvedBy          String?           @map("approved_by") @db.Uuid
  approvedAt          DateTime?         @map("approved_at")
  rejectedBy          String?           @map("rejected_by") @db.Uuid
  rejectedAt          DateTime?         @map("rejected_at")
  rejectedReason      String?           @map("rejected_reason")
  deletedAt           DateTime?         @map("deleted_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  // Regulations fields
  regulationId String?   @map("regulation_id") @db.Uuid
  acceptedAt   DateTime? @map("accepted_at")

  approver   User?       @relation("ApprovedApplications", fields: [approvedBy], references: [id], onDelete: SetNull)
  rejecter   User?       @relation("RejectedApplications", fields: [rejectedBy], references: [id], onDelete: SetNull)
  regulation Regulation? @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position   Position?   @relation(fields: [positionId], references: [id], onDelete: Restrict)

  // Relations
  applicationInvites ApplicationInvite[]
  attachments        ApplicationAttachment[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([approvedBy])
  @@index([rejectedBy])
  @@index([regulationId])
  @@index([departmentId])
  @@index([positionId])
  @@index([deletedAt])
  @@map("applications")
}

model ApplicationInvite {
  id        String                  @id @default(uuid()) @db.Uuid
  email     String
  token     String                  @unique
  status    ApplicationInviteStatus @default(UNUSED)
  expiresAt DateTime                @map("expires_at")
  usedAt    DateTime?               @map("used_at")

  applicationId String?      @map("application_id") @db.Uuid
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  createdBy String? @map("created_by") @db.Uuid
  creator   User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([token])
  @@index([status])
  @@index([applicationId])
  @@index([createdBy])
  @@map("application_invites")
}

model ApplicationAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  fileName      String   @map("file_name")
  fileUrl       String   @map("file_url")
  filePath      String   @map("file_path")
  mimeType      String   @map("mime_type")
  fileSize      Int      @map("file_size")
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_attachments")
}

model Regulation {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  content   String   @db.Text
  version   Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications Application[]
  acknowledgments RegulationAcknowledgment[]

  @@map("regulations")
}

// ─── Task Management & Assignments ──────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum AssignmentStatus {
  PENDING_APPROVAL
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
  EXTENSION_PENDING
}

enum ExtensionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskGroupStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model TaskGroup {
  id                String          @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  departmentId      String?         @map("department_id") @db.Uuid
  status            TaskGroupStatus @default(ACTIVE)
  maxWorkloadDays   Float           @default(10) @map("max_workload_days")
  maxActiveTasks    Int?            @map("max_active_tasks")
  requireAllMembers Boolean         @default(false) @map("require_all_members")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  department Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tasks      Task[]
  members    TaskGroupMember[]

  @@unique([name, departmentId])
  @@index([departmentId])
  @@index([status])
  @@map("task_groups")
}

model TaskGroupMember {
  taskGroupId String   @map("task_group_id") @db.Uuid
  internId    String   @map("intern_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  taskGroup TaskGroup @relation(fields: [taskGroupId], references: [id], onDelete: Cascade)
  intern    Intern    @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@id([taskGroupId, internId])
  @@index([internId])
  @@map("task_group_members")
}

model Task {
  id                 String       @id @default(uuid()) @db.Uuid
  taskGroupId        String?      @map("task_group_id") @db.Uuid
  code               String?
  title              String
  description        String?
  deadline           DateTime
  startDate          DateTime?    @map("start_date")
  estDays            Float?       @map("est_days")
  phase              String?
  module             String?
  acceptanceCriteria String?      @map("acceptance_criteria") @db.Text
  taskNotes          String?      @map("task_notes")
  priority           TaskPriority @default(MEDIUM)
  createdBy          String       @map("created_by") @db.Uuid
  deletedAt          DateTime?    @map("deleted_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  taskGroup   TaskGroup?       @relation(fields: [taskGroupId], references: [id], onDelete: SetNull)
  creator     User             @relation("CreatedTasks", fields: [createdBy], references: [id], onDelete: Cascade)
  assignment  TaskAssignment?
  attachments TaskAttachment[]

  recreatedTaskId String? @map("recreated_task_id") @db.Uuid
  recreatedTask   Task?   @relation("TaskRecreation", fields: [recreatedTaskId], references: [id], onDelete: SetNull)
  recreatedFrom   Task[]  @relation("TaskRecreation")

  dependencies Task[] @relation("TaskDependencies")
  dependsOn    Task[] @relation("TaskDependencies")

  @@unique([taskGroupId, code])
  @@index([createdBy])
  @@index([taskGroupId])
  @@index([recreatedTaskId])
  @@index([phase])
  @@index([deadline])
  @@index([deletedAt, deadline])
  @@index([deletedAt])
  @@map("tasks")
}

model TaskAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  filePath   String   @map("file_path")
  mimeType   String   @map("mime_type")
  fileSize   Int      @map("file_size")
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation("TaskAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedBy])
  @@map("task_attachments")
}

model TaskAssignment {
  id            String           @id @default(uuid()) @db.Uuid
  taskId        String           @unique @map("task_id") @db.Uuid
  internId      String?          @map("intern_id") @db.Uuid
  supportId     String?          @map("support_id") @db.Uuid
  assignedBy    String           @map("assigned_by") @db.Uuid
  status        AssignmentStatus @default(TODO)
  blockedReason String?          @map("blocked_reason") @db.Text
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  assignedAt    DateTime         @default(now()) @map("assigned_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  intern      Intern?          @relation("TaskAssignmentOwner", fields: [internId], references: [id], onDelete: Cascade)
  support     Intern?          @relation("TaskAssignmentSupport", fields: [supportId], references: [id], onDelete: SetNull)
  assigner          User                   @relation("AssignedTasks", fields: [assignedBy], references: [id], onDelete: Cascade)
  submissions       TaskSubmission[]
  extensionRequests TaskExtensionRequest[]

  @@index([internId])
  @@index([internId, status])
  @@index([supportId])
  @@index([assignedBy])
  @@index([status])
  @@map("task_assignments")
}

// ─── Task Submissions ────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model TaskSubmission {
  id            String       @id @default(uuid()) @db.Uuid
  assignmentId  String       @map("assignment_id") @db.Uuid
  attempt       Int
  prLink        String?      @map("pr_link")
  videoDemo     String?      @map("video_demo")
  note          String?      @db.Text
  reviewStatus  ReviewStatus @default(PENDING) @map("review_status")
  reviewComment String?      @map("review_comment") @db.Text
  reviewedBy    String?      @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?    @map("reviewed_at")
  submittedAt   DateTime     @default(now()) @map("submitted_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  assignment  TaskAssignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewer    User?                  @relation("ReviewedSubmissions", fields: [reviewedBy], references: [id], onDelete: SetNull)
  attachments SubmissionAttachment[]

  @@unique([assignmentId, attempt])
  @@index([assignmentId])
  @@index([reviewedBy])
  @@index([reviewStatus])
  @@map("task_submissions")
}

model SubmissionAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  filePath     String   @map("file_path")
  mimeType     String   @map("mime_type")
  fileSize     Int      @map("file_size")
  uploadedBy   String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploader   User           @relation("SubmissionAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([uploadedBy])
  @@map("submission_attachments")
}

model TaskExtensionRequest {
  id               String                 @id @default(uuid()) @db.Uuid
  assignmentId     String                 @map("assignment_id") @db.Uuid
  internId         String                 @map("intern_id") @db.Uuid
  currentDeadline  DateTime               @map("current_deadline")
  proposedDeadline DateTime               @map("proposed_deadline")
  extensionDays    Int                    @map("extension_days")
  reason           String                 @db.Text
  commitmentPlan   String                 @map("commitment_plan") @db.Text
  status           ExtensionRequestStatus @default(PENDING)
  rejectionReason  String?                @map("rejection_reason") @db.Text
  reviewedBy       String?                @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?              @map("reviewed_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  assignment TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  intern     Intern         @relation(fields: [internId], references: [id], onDelete: Cascade)
  reviewer   User?          @relation("ReviewedExtensionRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([assignmentId])
  @@index([internId])
  @@index([status])
  @@index([reviewedBy])
  @@map("task_extension_requests")
}

// ─── Meeting & Absence Enums ────────────────────────────────────────────────

enum MeetingType {
  ONLINE
  OFFLINE
  HYBRID
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum MeetingVisibility {
  PRIVATE
  TEAM
}

enum ParticipantRole {
  HOST
  ORGANIZER
  PARTICIPANT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AttendanceStatus {
  UNKNOWN
  ATTENDED
  ABSENT
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Meetings & Absences Models ─────────────────────────────────────────────

model Meeting {
  id          String            @id @default(uuid()) @db.Uuid
  title       String
  description String?           @db.Text
  minutes     String?           @db.Text
  createdBy   String            @map("created_by") @db.Uuid
  hostId      String            @map("host_id") @db.Uuid
  location    String?
  meetingType MeetingType       @default(ONLINE) @map("meeting_type")
  meetingLink String?           @map("meeting_link")
  startTime   DateTime          @map("start_time")
  endTime     DateTime          @map("end_time")
  departmentId String?          @map("department_id") @db.Uuid
  status      MeetingStatus     @default(DRAFT)
  visibility  MeetingVisibility @default(TEAM)
  deletedAt   DateTime?         @map("deleted_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  creator      User                 @relation("CreatedMeetings", fields: [createdBy], references: [id], onDelete: Restrict)
  host         User                 @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: Restrict)
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  absences     AbsenceRequest[]

  @@index([createdBy])
  @@index([hostId])
  @@index([departmentId])
  @@index([status])
  @@index([startTime])
  @@index([startTime, endTime])
  @@index([deletedAt])
  @@map("meetings")
}

model MeetingParticipant {
  id               String           @id @default(uuid()) @db.Uuid
  meetingId        String           @map("meeting_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  participantRole  ParticipantRole  @default(PARTICIPANT) @map("participant_role")
  invitationStatus InvitationStatus @default(PENDING) @map("invitation_status")
  attendanceStatus AttendanceStatus @default(UNKNOWN) @map("attendance_status")
  responseAt       DateTime?        @map("response_at")
  joinedAt         DateTime?        @map("joined_at")
  leftAt           DateTime?        @map("left_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  meeting  Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  absences AbsenceRequest[]

  @@unique([meetingId, userId])
  @@index([userId])
  @@index([meetingId])
  @@map("meeting_participants")
}

model AbsenceRequest {
  id            String        @id @default(uuid()) @db.Uuid
  meetingId     String        @map("meeting_id") @db.Uuid
  participantId String        @map("participant_id") @db.Uuid
  reason        String        @db.Text
  attachmentUrl String?       @map("attachment_url")
  status        AbsenceStatus @default(PENDING)
  reviewedBy    String?       @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?     @map("reviewed_at")
  reviewNote    String?       @map("review_note") @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  meeting     Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant MeetingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  reviewer    User?              @relation("ReviewedAbsences", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([meetingId, participantId])
  @@index([participantId])
  @@index([status])
  @@map("absence_requests")
}

model Absence {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  startDate   DateTime      @map("start_date")
  endDate     DateTime      @map("end_date")
  reason      String        @db.Text
  evidenceUrl String?       @map("evidence_url")
  status      AbsenceStatus @default(PENDING)
  reviewedBy  String?       @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?     @map("reviewed_at")
  reviewNote  String?       @map("review_note") @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user     User  @relation("InternAbsences", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewedGeneralAbsences", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("absences")
}

// ─── Daily Reports & Weekly Evaluations ────────────────────────────────────

enum EvaluationGrade {
  TOT
  KHA
  TB
  TBY
  YEU
}

model DailyReport {
  id          String   @id @default(uuid()) @db.Uuid
  internId    String   @map("intern_id") @db.Uuid
  date        DateTime @map("date") @db.Date
  content     String   @db.Text
  blockers    String?  @db.Text
  nextPlan    String?  @map("next_plan") @db.Text
  hoursWorked Float?   @default(8) @map("hours_worked")
  prLink      String?  @map("pr_link")
  videoDemo   String?  @map("video_demo")

  feedback    String?   @db.Text
  feedbackBy  String?   @map("feedback_by") @db.Uuid
  feedbackAt  DateTime? @map("feedback_at")

  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  intern       Intern             @relation(fields: [internId], references: [id], onDelete: Cascade)
  feedbackUser User?              @relation("FeedbackDailyReports", fields: [feedbackBy], references: [id], onDelete: SetNull)
  attachments  ReportAttachment[]

  @@unique([internId, date])
  @@index([internId])
  @@index([date])
  @@index([feedbackBy])
  @@index([deletedAt])
  @@map("daily_reports")
}

model ReportAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  reportId   String   @map("report_id") @db.Uuid
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  filePath   String   @map("file_path")
  mimeType   String   @map("mime_type")
  fileSize   Int      @map("file_size")
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploader User        @relation("ReportAttachmentUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([uploadedBy])
  @@map("report_attachments")
}

model WeeklyEvaluation {
  id              String           @id @default(uuid()) @db.Uuid
  internId        String           @map("intern_id") @db.Uuid
  leaderId        String           @map("leader_id") @db.Uuid
  week            Int
  year            Int
  startDate       DateTime?        @map("start_date")
  endDate         DateTime?        @map("end_date")

  ratings         Json             @map("ratings")
  aiRatings       Json?            @map("ai_ratings")

  score           Float            @map("score")
  grade           EvaluationGrade? @map("grade")

  comment         String?          @map("comment") @db.Text
  strengths       String[]         @default([])
  weaknesses      String[]         @default([])
  recommendations String[]         @default([])

  aiScore         Float?           @map("ai_score")
  aiComment       String?          @map("ai_comment") @db.Text
  aiStrengths     String[]         @default([]) @map("ai_strengths")
  aiWeaknesses    String[]         @default([]) @map("ai_weaknesses")
  aiRecommendations String[]       @default([]) @map("ai_recommendations")
  isAiAdjusted    Boolean          @default(false) @map("is_ai_adjusted")

  viewedAt        DateTime?        @map("viewed_at")

  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  intern Intern @relation(fields: [internId], references: [id], onDelete: Cascade)
  leader User   @relation("LeaderEvaluations", fields: [leaderId], references: [id], onDelete: Cascade)

  @@unique([internId, week])
  @@index([internId])
  @@index([leaderId])
  @@index([week])
  @@index([year])
  @@index([deletedAt])
  @@map("weekly_evaluations")
}

// ─── Export History & PDF Generation ────────────────────────────────────────

model ExportHistory {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   // WEEKLY_EVALUATION, INTERNSHIP_SUMMARY, TASK_REPORT, DASHBOARD_SUMMARY
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  fileName    String   @map("file_name")
  storagePath String   @map("storage_path")
  fileUrl     String   @map("file_url")
  createdById String   @map("created_by_id") @db.Uuid
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  creator User @relation("UserExports", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([entityId])
  @@index([type])
  @@map("export_histories")
}

// ─── Regulation Acknowledgments ─────────────────────────────────────────────

model RegulationAcknowledgment {
  id             String   @id @default(uuid()) @db.Uuid
  regulationId   String   @map("regulation_id") @db.Uuid
  internId       String   @map("intern_id") @db.Uuid
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")

  regulation Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  intern     Intern     @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([regulationId, internId])
  @@index([regulationId])
  @@index([internId])
  @@map("regulation_acknowledgments")
}

// ─── System Settings (Operational Configs) ──────────────────────────────────

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String
  description String?
  category    String   @default("GENERAL")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("system_settings")
}
